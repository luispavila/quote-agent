# LLM — Featherless
LLM_PROVIDER=featherless
LLM_MAX_TOKENS=1024
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_TEMPERATURE=0
WEB_SEARCH_URL=https://html.duckduckgo.com/html/
SUPPLIER_DISCOVERY_LIMIT=6

# Serviço WhatsApp opcional
WA_SERVICE_URL=http://wa-service:3001
WA_SHARED_TOKEN=

# Observabilidade opcional
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Aplicação
APP_ENV=dev
DATABASE_URL=sqlite:///./quote_agent.db
CORS_ORIGINS=*

# WhatsApp (wa-service Baileys)
# Token compartilhado entre api <-> wa-service (>=16 chars)
WA_SHARED_TOKEN=dev-token-0123456789
# URL do wa-service vista pela api (no compose local já é http://wa-service:3001)
WA_SERVICE_URL=
# No wa-service em produção: DATABASE_URL de um Postgres (auth state na tabela wa_auth).
# No Render: crie um Postgres free e cole a Internal Database URL. Sem ela, usa AUTH_DIR (disco).

# Docker / Postgres / HTTPS
DOMAIN=:80
POSTGRES_USER=quote
POSTGRES_PASSWORD=quote
POSTGRES_DB=quote
