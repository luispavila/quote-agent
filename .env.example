# ===== LLM =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024

# Fallback opcional (perk Featherless do hackathon — endpoint OpenAI-compatível)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ===== Observabilidade (Langfuse cloud) =====
# Sem estas chaves a app roda normalmente, só sem tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ===== App =====
APP_ENV=dev

# ===== Caddy / HTTPS =====
# ":80" = HTTP puro (local / primeiro deploy por IP)
# Para HTTPS: DOMAIN=<seu-dominio> ou DOMAIN=<EIP-com-tracos>.sslip.io
DOMAIN=:80

# ===== Postgres (checkpointer do agente — usado a partir do Marco 2) =====
POSTGRES_USER=quote
POSTGRES_PASSWORD=quote
POSTGRES_DB=quote
