# Copie para .env (local) e preencha. Em produção, cole no Environment do Render.

# ===== LLM =====
# Featherless é o PRIMÁRIO (perk do Hack2L); Anthropic é o fallback.
# Basta UMA das chaves para a app funcionar; com as duas, o fallback segura a demo.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024

# ===== Observabilidade (Langfuse cloud) =====
# Sem estas chaves a app roda normalmente, só sem tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ===== App =====
APP_ENV=dev

# ===== WhatsApp (wa-service Baileys) =====
# Token compartilhado entre api <-> wa-service (>=16 chars). No Render é gerado sozinho.
WA_SHARED_TOKEN=dev-token-0123456789
# URL do wa-service vista pela api (no compose local já é http://wa-service:3001)
WA_SERVICE_URL=

# ===== Caddy / HTTPS (compose local) =====
# ":80" = HTTP puro; para HTTPS: DOMAIN=<seu-dominio> ou <IP-com-tracos>.sslip.io
DOMAIN=:80

# ===== Postgres (checkpointer do agente — usado a partir do Marco 2) =====
POSTGRES_USER=quote
POSTGRES_PASSWORD=quote
POSTGRES_DB=quote
